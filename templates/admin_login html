<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Spice Garden Admin Login</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f7f2e8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .login-box {
            background: white;
            padding: 30px;
            border-radius: 12px;
            width: 320px;
            max-width: 85%;
            box-shadow: 0 4px 18px #0002;
        }
        input, button {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
            margin-top: 12px;
        }
        button {
            background: #a83224;
            color: white;
            border: 0;
            cursor: pointer;
        }
        .error { color: #b00020; }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>Spice Garden Admin</h2>
        <p>Sign in to manage reservations.</p>

        {% if error %}
        <p class="error">{{ error }}</p>
        {% endif %}

        <form method="POST">
            <label for="username">Username</label>
            <input id="username" name="username"
                   autocomplete="username" required>

            <label for="password">Password</label>
            <input id="password" name="password"
                   type="password"
                   autocomplete="current-password" required>

            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>
